+                    assert_eq!(actual.pixels, expected.data());
+                    if (width, height) == (64, 64) {
+                        if let Some(old) = &previous { assert_ne!(&actual.pixels, old); }
+                        previous = Some(actual.pixels);
+                    }
+                }
+            }
+        }
